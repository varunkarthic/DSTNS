// Apply sparse host updates to a device buffer: target[offset] = value for
// each (offset, value) record. The host never sends two records for one
// offset, so the order invocations run in cannot matter.

#version 460
#extension GL_GOOGLE_include_directive : require
#include "dstns_glsl.h"

layout(std430, set = 0, binding = 0) readonly buffer Records { u32 record_count; u32 pad0; u32 pad1; u32 pad2; uvec2 records[]; };
layout(std430, set = 0, binding = 1) buffer Target { u32 target[]; };

void main() {
    u32 i = gl_GlobalInvocationID.x;
    if (i < record_count) target[records[i].x] = records[i].y;
}
