// Surface water, pass 4: each face's discharge scaled by its donor's limiter,
// so momentum agrees with the water that moved. Mirrors CpuHydrology::advance.

#version 460
#extension GL_GOOGLE_include_directive : require
#include "dstns_glsl.h"
#include "dstns_hydrology.h"
#include "dstns_hydro_bindings.h"

i64 lim_at(int i, int j) {
    if (i < 0 || j < 0 || i >= int(grid_w()) || j >= int(grid_h())) return i64(65536);
    return i64(limiter[uint(j) * grid_w() + uint(i)]);
}

void main() {
    uint f = gl_GlobalInvocationID.x;
    uint w = grid_w(), ht = grid_h();
    uint nx = (w + 1u) * ht;
    if (f < nx) {
        int j = int(f / (w + 1u)), i = int(f % (w + 1u));
        i64 q = i64(qx[f]);
        if (q > i64(0)) qx[f] = clamp32(hyd_scaled(q, lim_at(i - 1, j)));
        else if (q < i64(0)) qx[f] = clamp32(hyd_scaled(q, lim_at(i, j)));
        return;
    }
    uint g = f - nx;
    if (g >= w * (ht + 1u)) return;
    int j = int(g / w), i = int(g % w);
    i64 q = i64(qy[g]);
    if (q > i64(0)) qy[g] = clamp32(hyd_scaled(q, lim_at(i, j - 1)));
    else if (q < i64(0)) qy[g] = clamp32(hyd_scaled(q, lim_at(i, j)));
}
