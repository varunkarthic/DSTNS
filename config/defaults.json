{
  "schema_version": "1.0",
  "seed": "auto",
  "day": 0,
  "playback": {
    "duration_seconds": 3600,
    "tick_rate": 1.0,
    "checkpoint_virtual_seconds": 900
  },
  "map": {
    "source": "OpenStreetMap",
    "max_nodes": 50000,
    "min_nodes": 9,
    "max_anchor_attempts": 64,
    "min_compactness": 0.1,
    "map_selection_version": "urban-crfg-v3",
    "on_demand": true,
    "cache_dir": "data/maps",
    "city_extent_m": 5000,
    "district_nodes": 3000,
    "cache_policy": "prune",
    "cache_keep": 1
  },
  "launcher": {
    "default_settings": false
  },
  "modules": {
    "traffic": true,
    "signals": true,
    "buildings": true,
    "dws": true,
    "flooding": true,
    "news": true
  },
  "bus_stops": {
    "min_spacing_m": 300,
    "target_spacing_m": 500,
    "max_coverage_m": 800,
    "building_annulus_m": [
      80,
      250
    ]
  },
  "traffic": {
    "demand_bin_virtual_s": 300,
    "route_probe_count": 512,
    "bpr_alpha": 0.15,
    "bpr_beta": 4
  },
  "dws": {
    "frequency": 3,
    "min_start_gap_playback_seconds": 5,
    "min_duration_virtual_min": 20,
    "max_duration_virtual_min": 120
  },
  "api": {
    "host": "127.0.0.1",
    "port": 8090
  },
  "narration": {
    "mode": "auto"
  },
  "ui": {
    "port": 5173,
    "osm_background": true
  },
  "logging": {
    "level": "INFO",
    "system_log": "logs/system.log",
    "database": "logs/runtime.db"
  },
  "fabric": {
    "applications": true,
    "legacy_api": true,
    "launch_proposals": true,
    "require_signatures": false,
    "world_regeneration": true,
    "allow_frames": true,
    "allow_dialogs": true,
    "allow_camera": true,
    "allow_layers": true,
    "allow_control": true,
    "allow_notifications": true,
    "allow_messages": true,
    "allow_storage": true
  },
  "webfabric": {
    "enabled": true
  },
  "startup": {
    "fast_boot": false,
    "force_animate": true
  },
  "presentation": {
    "music": false,
    "fullscreen": false,
    "music_volume": 0.6
  },
  "demo": {
    "music": true,
    "fullscreen": true
  }
}
