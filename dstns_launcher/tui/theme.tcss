/* The same design as the observer, as far as a terminal goes: its colours, its quiet surfaces, one
   rounded card for one thing, a line between things rather than a box around each, and plain words.
   Meaning never depends on colour; every state also has a symbol and a word. */

$bg: #071420;
$surface: #0D1C28;
$surface-alt: #122431;
$cyan: #37D7FF;
$cyan-bright: #6FE3FF;
$teal: #1E7C8F;
$navy: #243B4C;
$text: #E6F0F7;
$text-2: #93A8B6;
$muted: #5F7685;
$ok: #5EE3BF;
$warn: #F0AA2E;
$err: #EF5A64;

Screen {
    background: $bg;
    color: $text;
    layers: base overlay;
    overflow: hidden;
}

/* A quiet scrollbar, that shows where you are and otherwise keeps out of the way. */
VerticalScroll, Vertical, ScrollableContainer {
    scrollbar-size-vertical: 1;
    scrollbar-color: $navy;
    scrollbar-color-hover: $teal;
    scrollbar-color-active: $cyan;
    scrollbar-background: $bg;
    scrollbar-background-hover: $bg;
    scrollbar-background-active: $bg;
    scrollbar-corner-color: $bg;
}

/* --- Frame: header, body, key bar ------------------------------------- */

HeaderBar {
    dock: top;
    height: 3;
    background: $bg;
    color: $text;
    border: round $navy;
    padding: 0 1;
    margin: 0 1;
}

KeyBar {
    dock: bottom;
    height: 1;
    background: $bg;
    color: $text-2;
    padding: 0 2;
}

App.-small HeaderBar {
    height: 1;
    border: none;
    margin: 0;
}

.rule {
    height: 1;
    color: $navy;
}

.section-title {
    color: $text-2;
    text-style: bold;
    height: 1;
    margin-top: 1;
}

.muted {
    color: $text-2;
}

.dim {
    color: $muted;
}

.hint {
    color: $text-2;
    height: auto;
}

.error-text {
    color: $err;
}

/* --- Menu -------------------------------------------------------------- */

Menu {
    height: auto;
    width: 1fr;
    background: transparent;
    color: $text;
}

Menu:focus {
    background: transparent;
}

/* --- One rounded card for one thing -------------------------------------- */

.card {
    height: auto;
    width: 1fr;
    border: round $navy;
    border-title-color: $text-2;
    padding: 0 2 1 2;
    margin-top: 1;
}

.card:focus-within {
    border: round $teal;
    border-title-color: $cyan;
}

#cards {
    height: 5;
    width: 1fr;
    margin: 0 1;
}

#cards > .stat {
    width: 1fr;
    height: 5;
    border: round $navy;
    border-title-color: $text-2;
    padding: 0 1;
    margin-left: 1;
}

#cards > .stat:first-child {
    margin-left: 0;
}

App.-small #cards,
App.-medium #cards {
    display: none;
}

.field-hint {
    padding-left: 24;
    color: $muted;
}

TextArea {
    height: 6;
    background: transparent;
    border: round $navy;
    color: $text;
}

TextArea:focus {
    border: round $cyan;
}

App.-small .field-hint {
    padding-left: 2;
}

/* --- Splash ------------------------------------------------------------- */

#splash {
    align: center middle;
    width: 1fr;
    height: 1fr;
}

#splash-content {
    width: 76;
    max-width: 100%;
    height: auto;
}

#splash-content > * {
    width: 100%;
    max-width: 100%;
    content-align: center middle;
    text-align: center;
}

#splash Wordmark {
    color: $cyan;
    content-align: center middle;
    text-align: center;
}

#splash .full-name {
    color: $text;
    text-style: bold;
    margin-top: 1;
}

#splash .version {
    color: $text-2;
    margin-top: 1;
}

#splash .activity {
    color: $cyan;
    margin-top: 1;
    width: 100%;
}

#splash .legal {
    color: $muted;
    margin-top: 2;
}

App.-small #splash .legal {
    margin-top: 1;
}

/* --- Common body --------------------------------------------------------- */

.body {
    height: 1fr;
    width: 1fr;
    padding: 0 2;
}

.panel-title {
    color: $text;
    text-style: bold;
    height: 1;
    margin-bottom: 1;
}

#columns {
    height: 1fr;
    width: 100%;
}

#sidebar {
    width: 30;
    height: 1fr;
    border: round $navy;
    border-title-color: $text-2;
    padding: 0 1;
    margin: 0 0 0 1;
}

#sidebar:focus-within {
    border: round $teal;
    border-title-color: $cyan;
}

#content {
    width: 1fr;
    height: 1fr;
    border: round $navy;
    border-title-color: $text-2;
    padding: 0 2;
    margin: 0 1;
}

#content Rule {
    display: none;
}

StatusTable {
    height: auto;
    width: 1fr;
}

RunningScreen #progress,
RunningScreen #progress Bar {
    width: 1fr;
}

RunningScreen #log {
    min-height: 1;
}

/* --- Forms ---------------------------------------------------------------- */

FieldRow {
    height: auto;
    width: 1fr;
}

FieldRow .field-line {
    height: auto;
    width: 1fr;
}

FieldRow .label {
    width: 24;
    color: $text-2;
    padding-top: 1;
}

FieldRow .editor {
    width: 1fr;
    max-width: 60;
    height: auto;
    background: transparent;
}

FieldRow .unit {
    width: auto;
    min-width: 8;
    color: $muted;
    padding: 1 1 0 1;
}

FieldRow .problem {
    color: $err;
    height: auto;
    padding-left: 24;
    display: none;
}

FieldRow .problem.-shown {
    display: block;
}

/* No fill: a rounded border's line runs down the middle of its cell, so a fill would show outside it. */
Input {
    background: transparent;
    border: round $navy;
    color: $text;
    width: 1fr;
}

Input:focus {
    border: round $cyan;
}

Input.-invalid {
    border: round $err;
}

Switch {
    background: transparent;
    border: round $navy;
}

Switch:focus {
    border: round $cyan;
}

Select > SelectCurrent {
    background: transparent;
    border: round $navy;
}

Select:focus > SelectCurrent {
    border: round $cyan;
}

/* --- Progress and logs ------------------------------------------------------- */

ProgressBar Bar > .bar--bar {
    color: $cyan;
    background: $surface-alt;
}

ProgressBar Bar > .bar--complete {
    color: $ok;
}

RichLog {
    background: $surface;
    border: none;
    height: 1fr;
    min-height: 4;
    padding: 0 1;
    scrollbar-size-vertical: 1;
    scrollbar-color: $navy;
    scrollbar-background: $surface;
}

/* --- Dialogs ---------------------------------------------------------------- */

ModalScreen {
    align: center middle;
    background: $bg 70%;
}

.dialog {
    width: 64;
    max-width: 96%;
    height: auto;
    max-height: 90%;
    background: $surface;
    border: round $teal;
    border-title-color: $cyan;
    border-title-style: bold;
    padding: 1 2;
}

.dialog.-error {
    border: round $err;
    border-title-color: $err;
}

.dialog .message {
    height: auto;
    margin-bottom: 1;
}

#too-small {
    align: center middle;
    background: $bg;
}

#too-small > Static {
    width: auto;
    text-align: center;
}

/* --- Size classes: set on the App from the terminal size ------------------------ */

App.-medium #sidebar {
    width: 24;
}

App.-small #columns {
    layout: vertical;
}

App.-small #sidebar {
    width: 1fr;
    height: auto;
    border: none;
    border-bottom: solid $navy;
    padding: 0 1 1 1;
    margin: 0;
}

App.-small #content {
    border: none;
    padding: 1 1 0 1;
    margin: 0;
}

App.-small .body {
    padding: 0 1;
}

App.-small FieldRow .field-line {
    layout: vertical;
}

App.-small FieldRow .label {
    width: 1fr;
    padding-top: 0;
}


App.-small FieldRow .problem {
    padding-left: 2;
}

App.-small FieldRow .unit {
    padding: 0 0 0 2;
}

App.-small .hide-small {
    display: none;
}

App.-medium .hide-medium,
App.-small .hide-medium {
    display: none;
}
