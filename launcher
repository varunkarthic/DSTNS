# DSTNS launcher. Everything (interface choice, checks, exit codes) is in the Rust program in LaunchKit/; this builds
# it when its sources have changed, then runs it.
set -euo pipefail
root="$(cd "$(dirname "$0")" && pwd)"
export DSTNS_ROOT="$root"
# In a folder a cloud client syncs, keep the build on local disk: the client evicts files, and a build makes
# thousands of them.
case "$root" in
  */Library/CloudStorage/*|*/OneDrive*|*/Dropbox*|*"/Mobile Documents/"*|*"/Google Drive"*)
    if [ "$(uname)" = Darwin ]; then cache="$HOME/Library/Caches/DSTNS"; else cache="${XDG_CACHE_HOME:-$HOME/.cache}/dstns"; fi
    id="$(printf '%s' "$root" | shasum -a 256 | cut -c1-10)"
    export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$cache/checkout-$id/launcher}" ;;
esac
target="${CARGO_TARGET_DIR:-$root/LaunchKit/target}"
program="$target/release/dstns-launcher"
stale=""
if [ ! -x "$program" ]; then
  stale=1
elif [ -n "$(find "$root/LaunchKit/src" "$root/LaunchKit/assets" "$root/LaunchKit/Cargo.toml" "$root/LaunchKit/Cargo.lock" -newer "$program" -print -quit 2>/dev/null)" ]; then
  stale=1
fi
if [ -n "$stale" ]; then
  if ! command -v cargo >/dev/null 2>&1; then
    if [ -x "$program" ]; then
      echo "DSTNS: the launcher's sources changed, but cargo was not found to rebuild it; using the existing build." >&2
    else
      echo "DSTNS: the launcher is built with Rust, which was not found. Install it from https://rustup.rs and try again." >&2
      exit 1
    fi
  else
    echo "DSTNS: building the launcher, as its sources changed (about a minute)." >&2
    # A bar that fills as each crate is compiled, out of the crates in Cargo.lock. Cargo's own messages go to a log,
    # shown whole if the build fails. Without a terminal, cargo's plain output is shown instead.
    if [ -t 2 ]; then
      log="$(mktemp "${TMPDIR:-/tmp}/dstns-launcher-build.XXXXXX")"
      # How many units the last build had, or, the first time, an estimate from the packages in Cargo.lock.
      units="$target/.dstns-build-units"
      total="$(cat "$units" 2>/dev/null || echo $(( $(grep -c '^\[\[package\]\]' "$root/LaunchKit/Cargo.lock" || echo 100) * 3 / 5 )))"
      [ "$total" -gt 0 ] 2>/dev/null || total=100
      started=$SECONDS
      draw() {
        local done=$1 name=$2 width=30 filled
        filled=$(( done * width / total )); [ "$filled" -gt "$width" ] && filled=$width
        local percent=$(( done * 100 / total )); [ "$percent" -gt 99 ] && percent=99
        printf '\r\033[K  [%s%s] %3d%%  %3ds  %s' "$(printf '%*s' "$filled" '' | tr ' ' '#')" "$(printf '%*s' $(( width - filled )) '' | tr ' ' '-')" "$percent" $(( SECONDS - started )) "$name" >&2
      }
      count=0
      draw 0 "starting"
      if cargo build --release --message-format=json-render-diagnostics --manifest-path "$root/LaunchKit/Cargo.toml" 2>"$log" \
        | { while IFS= read -r message; do
            case "$message" in
              *'"reason":"compiler-artifact"'*)
                count=$(( count + 1 ))
                name="${message#*\"name\":\"}"; name="${name%%\"*}"
                draw "$count" "$name" ;;
            esac
          done; mkdir -p "$target"; echo "$count" > "$units"; }; then
        printf '\r\033[K  [%s] 100%%  %3ds  done\n' "$(printf '%*s' 30 '' | tr ' ' '#')" $(( SECONDS - started )) >&2
        rm -f "$log"
      else
        printf '\r\033[K' >&2
        cat "$log" >&2
        rm -f "$log"
        echo "DSTNS: the launcher did not build. The errors are above." >&2
        exit 1
      fi
    else
      cargo build --release --manifest-path "$root/LaunchKit/Cargo.toml" >&2
    fi
    echo "DSTNS: built. Starting the launcher." >&2
  fi
fi
exec "$program" "$@"
