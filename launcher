# DSTNS launcher. Everything (interface choice, checks, exit codes) is in Python.
set -euo pipefail
root="$(cd "$(dirname "$0")" && pwd)"
if ! command -v python3 >/dev/null 2>&1; then
  echo "DSTNS: python3 was not found. Install Python 3.10 or later and try again." >&2
  exit 1
fi
export PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m dstns_launcher "$@"
